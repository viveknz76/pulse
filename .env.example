# Postgres
POSTGRES_USER=checkin
POSTGRES_PASSWORD=checkin
POSTGRES_DB=checkin

# Backend
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Google Sign-In
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Restrict who can log in. List every authorized account explicitly.
ALLOWED_EMAILS=viveknz76@gmail.com

# Domain-wide access is disabled by default because all authorized users share
# the same check-in data. Only enable this deliberately for a trusted domain.
ALLOW_DOMAIN_ACCESS=false
ALLOWED_DOMAIN=

# Frontend build args
VITE_API_URL=http://localhost:4000
