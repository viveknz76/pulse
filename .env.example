# Postgres
POSTGRES_USER=checkin
POSTGRES_PASSWORD=checkin
POSTGRES_DB=checkin

# Backend
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Google Sign-In
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Restrict who can log in. Use ALLOWED_EMAILS for specific addresses
# (comma-separated) and/or ALLOWED_DOMAIN for a Google Workspace domain.
# Since your Google account uses ricado.co.nz SSO, setting ALLOWED_DOMAIN
# covers that automatically. Add your personal gmail too if you also sign
# in with viveknz76@gmail.com.
ALLOWED_EMAILS=viveknz76@gmail.com
ALLOWED_DOMAIN=ricado.co.nz

# Frontend build args
VITE_API_URL=http://localhost:4000
