# Postgres
POSTGRES_USER=checkin
POSTGRES_PASSWORD=checkin
POSTGRES_DB=checkin

# Backend
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
APP_TIME_ZONE=Pacific/Auckland

# Google Sign-In
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Google Calendar — uses the same Web application OAuth client as sign-in.
# Enable the Google Calendar API and add this exact Authorized redirect URI:
# http://localhost:4000/api/calendar/google/callback
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/api/calendar/google/callback

# Encrypts Google refresh tokens at rest. Generate with: openssl rand -hex 32
CALENDAR_TOKEN_ENCRYPTION_KEY=542830c3ff04dc08ad5c48d22ccb10e0f0e2d8b18afd6f6a5c0532f6fdb72f9b

# Used in Google Calendar event descriptions and OAuth redirects.
FRONTEND_URL=http://localhost:5173

# Restrict who can log in. List every authorized account explicitly.
ALLOWED_EMAILS=viveknz76@gmail.com

# Domain-wide access is disabled by default because all authorized users share
# the same check-in data. Only enable this deliberately for a trusted domain.
ALLOW_DOMAIN_ACCESS=false
ALLOWED_DOMAIN=

# Email (SendGrid) — used to send check-in summaries directly to team members.
# Sign up free at https://signup.sendgrid.com, then create an API key with
# "Mail Send" permission: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# Must match a sender verified via SendGrid's Single Sender Verification
# (Settings > Sender Authentication > Single Sender Verification). This lets
# you send TO any recipient (e.g. teammates' work addresses) without owning
# their domain's DNS — only this one "from" address needs verifying.
SENDGRID_FROM_EMAIL=

# Frontend build args
VITE_API_URL=http://localhost:4000
