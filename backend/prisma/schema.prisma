generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Cadence {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum CheckInStatus {
  SCHEDULED
  COMPLETED
  SKIPPED
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum CliftonStrength {
  ACHIEVER
  ACTIVATOR
  ADAPTABILITY
  ANALYTICAL
  ARRANGER
  BELIEF
  COMMAND
  COMMUNICATION
  COMPETITION
  CONNECTEDNESS
  CONSISTENCY
  CONTEXT
  DELIBERATIVE
  DEVELOPER
  DISCIPLINE
  EMPATHY
  FOCUS
  FUTURISTIC
  HARMONY
  IDEATION
  INCLUDER
  INDIVIDUALIZATION
  INPUT
  INTELLECTION
  LEARNER
  MAXIMIZER
  POSITIVITY
  RELATOR
  RESPONSIBILITY
  RESTORATIVE
  SELF_ASSURANCE
  SIGNIFICANCE
  STRATEGIC
  WOO
}

model Team {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  members TeamMember[]

  @@index([archivedAt])
}

model TeamMember {
  id                 String            @id @default(cuid())
  name               String
  role               String?
  email              String?
  avatarUrl          String?
  avatarSeed         String?
  cadence            Cadence           @default(FORTNIGHTLY)
  active             Boolean           @default(true)
  startDate          DateTime          @default(now()) @db.Date
  notes              String?
  checkInsPausedAt   DateTime?         @db.Timestamptz(3)
  checkInsResumeOn   DateTime?         @db.Date
  checkInsHoldReason String?
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?         @db.Timestamptz(3)
  deletedBy          String?
  cliftonStrengths   CliftonStrength[] @default([])
  teamId             String?
  team               Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)

  checkIns       CheckIn[]
  actionItems    ActionItem[]
  talkingPoints  TalkingPoint[]
  calendarEvents CheckInCalendarEvent[]

  @@index([deletedAt])
  @@index([teamId])
}

model CheckIn {
  id           String     @id @default(cuid())
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  teamMemberId String

  scheduledDate DateTime      @db.Date
  completedAt   DateTime?     @db.Timestamptz(3)
  status        CheckInStatus @default(SCHEDULED)

  wins         String?
  challenges   String?
  decisions    String?
  growthNotes  String?
  privateNotes String?
  energyLevel  Int?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  actionItems   ActionItem[]
  talkingPoints TalkingPoint[]

  @@index([teamMemberId, scheduledDate])
  @@index([deletedAt])
}

model ActionItem {
  id          String           @id @default(cuid())
  description String
  status      ActionItemStatus @default(OPEN)
  dueDate     DateTime? @db.Date
  completedAt DateTime? @db.Timestamptz(3)

  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  teamMemberId String

  checkIn   CheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  checkInId String?

  carriedOverFrom   ActionItem? @relation("CarryOver", fields: [carriedOverFromId], references: [id])
  carriedOverFromId String?     @unique
  carriedOverTo     ActionItem? @relation("CarryOver")

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([teamMemberId, status])
  @@index([dueDate])
  @@index([deletedAt])
}

model TalkingPoint {
  id         String    @id @default(cuid())
  content    String
  resolved   Boolean   @default(false)
  resolvedAt DateTime? @db.Timestamptz(3)
  recurring  Boolean   @default(false)

  renewedFrom   TalkingPoint? @relation("TalkingPointRenewal", fields: [renewedFromId], references: [id])
  renewedFromId String?       @unique
  renewedTo     TalkingPoint? @relation("TalkingPointRenewal")

  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  teamMemberId String

  checkIn   CheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  checkInId String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([teamMemberId, resolved])
  @@index([deletedAt])
}

model CalendarConnection {
  id                    String   @id @default(cuid())
  userEmail             String   @unique
  googleAccountEmail    String
  encryptedRefreshToken String
  scope                 String?
  calendarId            String   @default("primary")
  connectedAt           DateTime @default(now()) @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  events CheckInCalendarEvent[]
}

model CheckInCalendarEvent {
  id             String   @id @default(cuid())
  userEmail      String
  teamMemberId   String
  googleEventId  String
  htmlLink       String?
  startsAt       DateTime @db.Timestamptz(3)
  endsAt         DateTime @db.Timestamptz(3)
  createdByPulse Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  connection CalendarConnection @relation(fields: [userEmail], references: [userEmail], onDelete: Cascade)
  teamMember TeamMember         @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([userEmail, googleEventId])
  @@index([teamMemberId, startsAt])
  @@index([userEmail, startsAt])
}
