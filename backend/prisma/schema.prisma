generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Cadence {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum CheckInStatus {
  SCHEDULED
  COMPLETED
  SKIPPED
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum ActionItemOwner {
  MANAGER
  TEAM_MEMBER
  SHARED
}

model TeamMember {
  id                 String    @id @default(cuid())
  name               String
  role               String?
  email              String?
  avatarUrl          String?
  avatarSeed         String?
  cadence            Cadence   @default(FORTNIGHTLY)
  active             Boolean   @default(true)
  startDate          DateTime  @default(now())
  notes              String?
  checkInsPausedAt   DateTime?
  checkInsResumeOn   DateTime?
  checkInsHoldReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  deletedBy          String?

  checkIns      CheckIn[]
  actionItems   ActionItem[]
  talkingPoints TalkingPoint[]

  @@index([deletedAt])
}

model CheckIn {
  id           String     @id @default(cuid())
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  teamMemberId String

  scheduledDate DateTime
  completedAt   DateTime?
  status        CheckInStatus @default(SCHEDULED)

  wins        String?
  challenges  String?
  decisions   String?
  growthNotes String?
  energyLevel Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  actionItems   ActionItem[]
  talkingPoints TalkingPoint[]

  @@index([teamMemberId, scheduledDate])
  @@index([deletedAt])
}

model ActionItem {
  id          String           @id @default(cuid())
  description String
  status      ActionItemStatus @default(OPEN)
  owner       ActionItemOwner  @default(SHARED)
  dueDate     DateTime?
  completedAt DateTime?

  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  teamMemberId String

  checkIn   CheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  checkInId String?

  carriedOverFrom   ActionItem? @relation("CarryOver", fields: [carriedOverFromId], references: [id])
  carriedOverFromId String?     @unique
  carriedOverTo     ActionItem? @relation("CarryOver")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([teamMemberId, status])
  @@index([dueDate])
  @@index([deletedAt])
}

model TalkingPoint {
  id         String    @id @default(cuid())
  content    String
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  recurring  Boolean   @default(false)

  renewedFrom   TalkingPoint? @relation("TalkingPointRenewal", fields: [renewedFromId], references: [id])
  renewedFromId String?       @unique
  renewedTo     TalkingPoint? @relation("TalkingPointRenewal")

  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  teamMemberId String

  checkIn   CheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  checkInId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([teamMemberId, resolved])
  @@index([deletedAt])
}
