generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Cadence {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum CheckInStatus {
  SCHEDULED
  COMPLETED
  SKIPPED
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum CliftonStrength {
  ACHIEVER
  ACTIVATOR
  ADAPTABILITY
  ANALYTICAL
  ARRANGER
  BELIEF
  COMMAND
  COMMUNICATION
  COMPETITION
  CONNECTEDNESS
  CONSISTENCY
  CONTEXT
  DELIBERATIVE
  DEVELOPER
  DISCIPLINE
  EMPATHY
  FOCUS
  FUTURISTIC
  HARMONY
  IDEATION
  INCLUDER
  INDIVIDUALIZATION
  INPUT
  INTELLECTION
  LEARNER
  MAXIMIZER
  POSITIVITY
  RELATOR
  RESPONSIBILITY
  RESTORATIVE
  SELF_ASSURANCE
  SIGNIFICANCE
  STRATEGIC
  WOO
}

model TeamMember {
  id                 String            @id @default(cuid())
  name               String
  role               String?
  email              String?
  avatarUrl          String?
  avatarSeed         String?
  cadence            Cadence           @default(FORTNIGHTLY)
  active             Boolean           @default(true)
  startDate          DateTime          @default(now())
  notes              String?
  checkInsPausedAt   DateTime?
  checkInsResumeOn   DateTime?
  checkInsHoldReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  deletedBy          String?
  cliftonStrengths   CliftonStrength[] @default([])

  checkIns       CheckIn[]
  actionItems    ActionItem[]
  talkingPoints  TalkingPoint[]
  calendarEvents CheckInCalendarEvent[]

  @@index([deletedAt])
}

model CheckIn {
  id           String     @id @default(cuid())
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  teamMemberId String

  scheduledDate DateTime
  completedAt   DateTime?
  status        CheckInStatus @default(SCHEDULED)

  wins         String?
  challenges   String?
  decisions    String?
  growthNotes  String?
  privateNotes String?
  energyLevel  Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  actionItems   ActionItem[]
  talkingPoints TalkingPoint[]

  @@index([teamMemberId, scheduledDate])
  @@index([deletedAt])
}

model ActionItem {
  id          String           @id @default(cuid())
  description String
  status      ActionItemStatus @default(OPEN)
  dueDate     DateTime?
  completedAt DateTime?

  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  teamMemberId String

  checkIn   CheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  checkInId String?

  carriedOverFrom   ActionItem? @relation("CarryOver", fields: [carriedOverFromId], references: [id])
  carriedOverFromId String?     @unique
  carriedOverTo     ActionItem? @relation("CarryOver")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([teamMemberId, status])
  @@index([dueDate])
  @@index([deletedAt])
}

model TalkingPoint {
  id         String    @id @default(cuid())
  content    String
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  recurring  Boolean   @default(false)

  renewedFrom   TalkingPoint? @relation("TalkingPointRenewal", fields: [renewedFromId], references: [id])
  renewedFromId String?       @unique
  renewedTo     TalkingPoint? @relation("TalkingPointRenewal")

  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  teamMemberId String

  checkIn   CheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  checkInId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([teamMemberId, resolved])
  @@index([deletedAt])
}

model CalendarConnection {
  id                    String   @id @default(cuid())
  userEmail             String   @unique
  googleAccountEmail    String
  encryptedRefreshToken String
  scope                 String?
  calendarId            String   @default("primary")
  connectedAt           DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  events CheckInCalendarEvent[]
}

model CheckInCalendarEvent {
  id             String   @id @default(cuid())
  userEmail      String
  teamMemberId   String
  googleEventId  String
  htmlLink       String?
  startsAt       DateTime
  endsAt         DateTime
  createdByPulse Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  connection CalendarConnection @relation(fields: [userEmail], references: [userEmail], onDelete: Cascade)
  teamMember TeamMember         @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([userEmail, googleEventId])
  @@index([teamMemberId, startsAt])
  @@index([userEmail, startsAt])
}
