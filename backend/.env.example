COOKIE_SECURE=false

# Email (SendGrid) — used to send check-in summaries directly to team members.
# Sign up free at https://signup.sendgrid.com, then create an API key with
# "Mail Send" permission: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# Must match a sender verified via SendGrid's Single Sender Verification
# (Settings > Sender Authentication > Single Sender Verification). This lets
# you send TO any recipient (e.g. teammates' work addresses) without owning
# their domain's DNS — only this one "from" address needs verifying.
SENDGRID_FROM_EMAIL=
